[Unit]
Description=Maintain PNLX Testnet rewards contract storage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/PNLX
EnvironmentFile=/home/ubuntu/PNLX/.env
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.bun/bin/bun scripts/operations/keepalive-rewards.ts --source pnlx-testnet --execute
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
