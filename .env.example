# PNLX server environment example. Copy to .env and fill in the blanks.

# --- Runtime ---
NODE_ENV=development
PORT=4000
PNLX_MARKET_ID=xlm-usd-perp
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pnlx
MONGODB_PROTOCOL_COLLECTION=protocol_state

# --- Auth ---
AUTH_REQUIRED=false
AUTH_SESSION_SECRET=

# --- Matcher service ---
MATCHER_SERVICE_URL=
MATCHER_SERVICE_TOKEN=
MATCHER_API_TOKEN=
MATCHER_PORT=4102
MATCHER_PROVIDER=risc0
PRIVATE_MATCHING_REQUIRED=false
MAKER_WALLET_ADDRESS=
PNLX_WEB_ORIGINS=

# --- Batch matching and proving ---
BATCH_EXECUTOR_ENABLED=true
BATCH_EXECUTOR_INTERVAL_MS=5000
BATCH_EXECUTOR_PROOF_CONCURRENCY=2
BATCH_EXECUTOR_PREFIX=auto
LIQUIDATION_AUTOMATION_ENABLED=true
LIQUIDATION_AUTOMATION_INTERVAL_MS=5000

# Prover backend: "runpod" (production GPU worker) or "local" (spawn the
# prover binary on this machine; development only). Unset picks "runpod"
# when both RUNPOD_API_KEY and RUNPOD_ENDPOINT_ID are set, else "local".
PNLX_PROVER_BACKEND=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Shared secret checked by workloads/runpod/handler.py; set the same value on
# the RunPod endpoint environment.
PNLX_WORKER_AUTH_TOKEN=
# Deadline for one proof job in milliseconds (default: 65 minutes).
PNLX_RISC0_PROVER_TIMEOUT_MS=3900000

# Deadline for the CPU Groth16 wrap on this machine, in milliseconds (default 30 minutes).
PNLX_RISC0_WRAP_TIMEOUT_MS=1800000
PNLX_RISC0_WRAP_SOCKET=/run/pnlx-risc0-wrap/prover.sock

# --- Client prover daemon (Noir witness service) ---
PNLX_PROVER_URL=http://127.0.0.1:4101
NEXT_PUBLIC_PNLX_PROVER_URL=/api/prover
NEXT_PUBLIC_PNLX_API_URL=http://127.0.0.1:4000
SERVER_WITNESS_ROUTES_ENABLED=false

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-rpc.testnet.stellar.gateway.fm
STELLAR_SOURCE=pnlx-testnet
STELLAR_DEPLOYER_ADDRESS=
STELLAR_DEPLOYMENT_FILE=deployments/testnet.json
STELLAR_ONCHAIN_RELAY=true
STELLAR_RELAYER_MODE=stellar-cli
STELLAR_COMMAND_TIMEOUT_MS=45000

# --- On-chain finality gates ---
INTENT_REGISTRY_ONCHAIN_REQUIRED=true
CONDITIONAL_ORDERS_ONCHAIN_REQUIRED=true
SETTLEMENTS_ONCHAIN_REQUIRED=true
ORACLE_ONCHAIN_REQUIRED=true

# --- Custody and treasury ---
ASSET_CUSTODY_REQUIRED=true
COLLATERAL_ASSET=
COLLATERAL_ASSET_CODE=
COLLATERAL_ASSET_ISSUER=
COLLATERAL_TOKEN_CONTRACT=
COLLATERAL_TOKEN_DIGEST=
INSURANCE_FUND_ADDRESS=
TREASURY_ADDRESS=
PROTOCOL_ADMIN_ADDRESSES=
PROTOCOL_ADMIN_REQUIRED=false

# --- Oracle (Pyth / SEP40) ---
ORACLE_CONTRACT_ID=
ORACLE_KIND=sep40
ORACLE_PRICE_SOURCE=onchain-market
ORACLE_ASSET_ADDRESS=
ORACLE_ASSET_SYMBOL=XLM
ORACLE_ASSET_TYPE=other
ORACLE_PUBLISH_MODE=committee
ORACLE_PUBLISHER_ADDRESSES=
ORACLE_PUBLISHER_SOURCES=
ORACLE_PRICE_MAX_AGE_SECONDS=120
ORACLE_COMMITTEE_MAX_AGE_SECONDS=120
ORACLE_COMMITTEE_MAX_DEVIATION_BPS=100
ORACLE_COMMITTEE_THRESHOLD=2
ORACLE_MAX_CONFIDENCE_BPS=100
ORACLE_PRICE_DECIMALS=8
ORACLE_TWAP_RECORDS=1
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_BTC_USD_FEED_ID=
PYTH_ETH_USD_FEED_ID=
PYTH_SOL_USD_FEED_ID=
PYTH_XLM_USD_FEED_ID=
PYTH_XRP_USD_FEED_ID=

# --- Funding engine ---
FUNDING_ENGINE_ENABLED=true
FUNDING_INTERVAL_MS=3600000
FUNDING_MINIMUM_SAMPLES=10
FUNDING_SAMPLE_INTERVAL_MS=60000
FUNDING_PREMIUM_MODE=fixed
FUNDING_PREMIUM_RATE=
FUNDING_PREMIUM_RATE_CAP=5000
FUNDING_IMPACT_MARGIN=5000000000
FUNDING_MAX_DELTA=

# --- Smoke tests ---
PNLX_SMOKE_MARKETS=
