[Unit]
Description=PNLX rewards escrow ledger upkeep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/PNLX
EnvironmentFile=/home/ubuntu/PNLX/.env
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.bun/bin/bun scripts/operations/keepalive-rewards.ts --source pnlx-maker --execute
TimeoutStartSec=3600
